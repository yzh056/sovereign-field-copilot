# Copy to .env.local and set the Linux-native path of your verified GGUF model.

SFC_LOCAL_LLM_MODEL_SRC=/home/you/.qvac/models/your-llama-3.2.gguf
SFC_LOCAL_TRANSCRIPTION_MODEL_SRC=/home/you/.qvac/models/your-whisper-model.bin
SFC_SAMPLE_AUDIO_PATH=/home/you/qvac-linux/audio/sample.wav
SFC_DAY3_QUERY=Someone has severe bleeding after an industrial accident. What should I do first?

# Day 4 provider / delegated inference
SFC_PROVIDER_PUBLIC_KEY=
SFC_PROVIDER_TOPIC=
SFC_PROVIDER_WARMUP_PROMPT=Reply with OK.
SFC_PROVIDER_HEALTH_TIMEOUT_MS=3000

# Day 5 state machine / dual-track RAG
SFC_DAY5_QUERY=Someone has severe bleeding after an industrial accident. What should I do first?
SFC_HEARTBEAT_INTERVAL_MS=5000
SFC_HEARTBEAT_PROBES=1

# Day 6 local field report persistence
SFC_DAY6_QUERY=Generate a field handoff report for severe bleeding after an industrial accident.
SFC_REPORT_DIR=.sfc/reports
